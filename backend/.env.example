APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

# Origen del frontend en desarrollo (CORS con credenciales).
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=biblioteca_siesa
DB_USERNAME=biblioteca
DB_PASSWORD=biblioteca_dev

# En producción con HTTPS debe ser true.
SESSION_SECURE_COOKIE=false

# Directorio de PDFs, relativo a backend/. Debe quedar fuera de public/.
STORAGE_DOCUMENTS_PATH=storage/documents

MAX_UPLOAD_MB=20
